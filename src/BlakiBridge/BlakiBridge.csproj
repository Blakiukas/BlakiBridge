<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>BlakiBridge.ico</ApplicationIcon>
    <Version>1.0.4</Version>
    <AssemblyVersion>1.0.4.0</AssemblyVersion>
    <FileVersion>1.0.4.0</FileVersion>
    <AssemblyName>BlakiBridge</AssemblyName>
    <RootNamespace>BlakiBridge</RootNamespace>
  </PropertyGroup>


  <PropertyGroup Condition="'$(StoreBuild)' == 'true'">
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <DefineConstants>$(DefineConstants);STORE_PACKAGE</DefineConstants>
  </PropertyGroup>

</Project>
